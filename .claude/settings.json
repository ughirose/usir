{
    "permissions":  {
                        "allow":  [
                                      "Bash(git status*)",
                                      "Bash(git diff*)",
                                      "Bash(git log*)",
                                      "Bash(git show*)",
                                      "Bash(git branch*)",
                                      "Bash(git ls-files*)",
                                      "Bash(git grep*)",
                                      "Bash(pnpm test*)",
                                      "Bash(pnpm run test*)",
                                      "Bash(pnpm build*)",
                                      "Bash(pnpm --filter * test*)",
                                      "Bash(uv run pytest*)",
                                      "Bash(npx vitest*)",
                                      "Bash(npx tsc*)"
                                  ],
                        "deny":  [
                                     "Read(./.env)",
                                     "Read(./.env.*)",
                                     "Read(**/*secret*)",
                                     "Read(**/*.pem)",
                                     "Bash(git push --force*)",
                                     "Bash(git push -f*)",
                                     "Bash(git reset --hard*)",
                                     "Bash(git clean*)",
                                     "Bash(rm -rf*)",
                                     "Bash(Remove-Item -Recurse*)"
                                 ]
                    }
}

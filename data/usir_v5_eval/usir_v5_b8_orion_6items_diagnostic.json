  "task1_h1_h2_crossrun_separation": {
    "orion_inquiry_1": "H1/H2 signal non-reproduction: Data effect vs Implementation/Definition effect",
    "code_level_definition_differences": {
      "item_a_centroid_population": {
        "b7_definition": "Centroids z*_corpus and z*_author computed from Aozora 106-works scene vectors (lines 415, 417). Vectors v_corp = z*_corpus - z_before and v_target = z*_author - z_before define directions from pre-edit text towards corpus mean and target author. Angle theta is measured between v_target and v_corp (median theta = 16.70 deg in ortho28, 28.6 deg in 6pole).",
        "b8_definition": "Centroid corp_vec computed from 40-work sample (line 334). Crucially, line 364 calls gram_schmidt_residual(v_t, corp_vec) where v_t = z_a - z_b (the micro-difference itself!) and corp_vec is the absolute origin coordinate vector. Consequently, theta measures the angle between micro-diff and absolute origin position, generating an irrelevant mathematical angle of 77.02 deg (ortho28) and 130.20 deg (6pole)."
      },
      "item_b_class_b_target_definition": {
        "b7_definition": "Target style centroid z*_target defined by Leave-One-Source-Out translator style centroids (TR_RIGID, TR_EMOTIONAL, TR_CONVERSATIONAL) (lines 790-792). Evaluates whether edits align with the target style.",
        "b8_definition": "Target translator style centroid was completely omitted. In Class B (lines 496-508), p['author_id'] was 'D10_TRANSLATOR', which was absent from proto_map. Consequently other_aids contained all 10 Aozora authors, making other_proto_mean identically equal to corp_vec. v_other = other_proto_mean - corp_vec became exactly zero for all 16 D10 pairs."
      },
      "item_c_wilcoxon_w5_root_cause": {
        "root_cause_explanation": "In B-8 lines 496-508, exactly 16 out of 22 pairs had norm_vo < 1e-12, appending 0.0 to cos_others. Only the 6 literary revision pairs (lines 16-21) had actual author IDs and non-zero differences. In run_wilcoxon_two_sided (line 178), non-zero differences had length N=5 (one literary pair had zero diff). For N=5, any one-directional rank sum yields W=5.0, p=0.6250 by combinatorial necessity.",
        "d10_pair_composition_shift": "B-7 used 12 directional pairs (TR_STANDARD -> 3 styles x 4 sources). B-8 dataset generated 16 pairs containing reverse translations (3 styles -> TR_STANDARD) and TR_RIGID -> TR_EMOTIONAL, without registering the target style direction."
      },
      "item_d_standardization_and_wilcoxon_tests": {
        "b7_testing": "Tested (cos_spec - cos_rand) and (cos_spec - cos_other) with one-sided alternative='greater'.",
        "b8_testing": "Tested raw cos_rand and cos_other against 0 with two-sided alternative='two-sided', failing to test directional superiority."
      }
    },

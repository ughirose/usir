    "closed_class_coverage_threshold_audit": {
      "heuristic_initial_threshold_pct": 85.0,
      "status": "CALIBRATION_PENDING_EXCESSIVE_INITIAL_HEURISTIC",
      "empirical_range_observed_pct": [
        55.64,
        63.22
      ],
      "finding": "Initial uncalibrated threshold (85% coverage) was an excessively optimistic prior. Empirical closed-class grammar skeleton tokens comprise 55-63% in authentic prose (R1: 58.88%, R2: 56.74%, R3: 55.64%, R4: 63.22%). Closed-class coverage does NOT reach 85% in any natural Japanese literary register. Threshold must be calibrated to 52.0% (safely below R3 minimum) for production filtering."
    },
    "outlier_rate_threshold_audit": {
      "heuristic_initial_threshold_pct": 10.0,
      "status": "MEASURED_AGAINST_R4_BASELINE",
      "finding": "Outlier rate depends strictly on reference distribution definition. Under R4 3-sigma threshold (7.97): outlier rate = 62.5% [95% CI: 41.7% - 83.3%]. Under Chi2(df=31) p=0.95 threshold (6.71): outlier rate = 83.3% [95% CI: 66.7% - 95.8%]."
    }
  },
